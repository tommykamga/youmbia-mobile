# Supabase local development must use an isolated QA project, never production.
# Session is persisted with expo-sqlite localStorage (app sandbox, survives restarts).
# Required: the app throws at startup if either variable is missing (fail-fast).
# Copy to .env and set real values. Never commit .env.
#
# EAS Build (profil production / Play Store / App Store) :
# Définir les MÊMES clés sur https://expo.dev → Projet → Environment variables
# (profil production), sinon le bundle n’embarque pas Supabase. Identiques au site web.
#
# Dashboard: add mobile redirect URLs + email template notes → docs/SUPABASE_MAGIC_LINK_AND_REDIRECTS.md
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PROJECT_REF=abcdefghijklmnopqrst
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Separate EAS project for development/preview QA; obtained after project creation.
YOUMBIA_EAS_PROJECT_ID=SET_AFTER_QA_EAS_PROJECT_CREATION
CRON_SECRET=your-cron-secret
EXPO_PUBLIC_MIXPANEL_TOKEN=

# Optional. If empty, Sentry does not initialize and the app runs normally.
EXPO_PUBLIC_SENTRY_DSN=

# Build-time environment label inlined in the JS bundle: development | preview | production
EXPO_PUBLIC_APP_ENV=development

# Private EAS / CI secrets — never prefix with EXPO_PUBLIC, never commit values:
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
# GOOGLE_SERVICES_JSON=  # EAS file variable pointing to Firebase google-services.json
