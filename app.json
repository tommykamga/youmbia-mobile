{
  "expo": {
    "name": "YOUMBIA",
    "slug": "youmbia-mobile",
    "version": "4.4.1",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "youmbiamobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.youmbia.mobile",
      "usesAppleSignIn": true,
      "splash": {
        "image": "./assets/images/splash.png",
        "resizeMode": "contain",
        "backgroundColor": "#0B6B3A"
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B6B3A"
    },
    "android": {
      "package": "com.youmbia.mobile",
      "versionCode": 34,
      "softwareKeyboardLayoutMode": "resize",
      "splash": {
        "image": "./assets/images/splash.png",
        "resizeMode": "contain",
        "backgroundColor": "#0B6B3A"
      },
      "adaptiveIcon": {
        "backgroundColor": "#0B6B3A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "https",
              "host": "www.youmbia.com",
              "pathPrefix": "/annonce"
            },
            {
              "scheme": "https",
              "host": "youmbia.com",
              "pathPrefix": "/annonce"
            }
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "extra": {
      "eas": {
        "projectId": "2869afc2-e13f-48b5-8e78-acbe5186934c"
      }
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-notifications",
      "expo-apple-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "YOUMBIA accède à vos photos pour ajouter des images à vos annonces et à votre profil.",
          "cameraPermission": "YOUMBIA accède à votre caméra pour prendre une photo de profil.",
          "microphonePermission": false
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "note": "Use SENTRY_AUTH_TOKEN, SENTRY_ORG and SENTRY_PROJECT env vars. Never commit tokens or DSN in source."
        }
      ]
    ]
  }
}
