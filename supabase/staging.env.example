# YOUMBIA Lifecycle Email P0 — variables staging (AUCUNE valeur secrète ici)
# Copier vers un gestionnaire de secrets staging. Ne jamais committer de .env réel.
# Projet : Supabase STAGING indépendant — pas le ref production.

# --- Projet staging (à renseigner après création autorisée) ---
# SUPABASE_URL=https://<STAGING_PROJECT_REF>.supabase.co
# SUPABASE_ANON_KEY=<staging-anon>
# SUPABASE_SERVICE_ROLE_KEY=<staging-service-role>   # via SUPABASE_SECRET_KEYS.default côté Edge

# --- Edge Functions lifecycle (deploy staging only) ---
# LIFECYCLE_EMAIL_DISPATCH_SECRET=<random-32B>
# LIFECYCLE_EMAIL_HMAC_SECRET=<random-32B>
# LIFECYCLE_RESEND_WEBHOOK_SECRET=whsec_<staging-only>
# LIFECYCLE_RESEND_API_KEY=re_<staging-or-test-key>
# LIFECYCLE_FROM_EMAIL=YOUMBIA Staging <no-reply@mail.example.test>
# LIFECYCLE_PUBLIC_FUNCTIONS_BASE=https://<STAGING_PROJECT_REF>.supabase.co/functions/v1

# --- Safety (recette) ---
# LIFECYCLE_EMAIL_ALLOW_LIVE=false
# LIFECYCLE_EMAIL_DRY_RUN=true
# LIFECYCLE_EMAIL_TRANSPORT=dry_run
# LIFECYCLE_EMAIL_ISOLATION=test          # bloque mode live même si ALLOW_LIVE fuité
# LIFECYCLE_EMAIL_LIVE_PROVIDER=false     # requis true + TRANSPORT=live pour api.resend.com
# LIFECYCLE_RESEND_BASE_URL=              # mock http interne en lab ; live = https://api.resend.com uniquement
# Kill switch DB : public.app_runtime_flags.lifecycle_email_kill_switch = 'true'
# (si row absente → fail-closed ON, migration 20261017170000)

# --- Deploy Edge (staging) ---
# send-lifecycle-email : déployer avec --no-verify-jwt (pg_net n’envoie que X-Lifecycle-Email-Dispatch-Secret)
#   OU injecter Authorization service_role dans net.http_post — aligner les deux.
# lifecycle-email-unsubscribe / lifecycle-email-webhook : --no-verify-jwt (public HMAC/Svix)

# --- Vault (SQL, hors git) ---
# vault.create_secret('https://<STAGING_REF>.supabase.co/functions/v1/send-lifecycle-email', 'lifecycle_email_functions_url')
# vault.create_secret('<same-as-DISPATCH>', 'lifecycle_email_dispatch_secret')

# --- Interdit ---
# Ne pas coller d’URL/key du projet production
# Ne pas mettre ALLOW_LIVE=true / LIVE_PROVIDER=true / kill OFF sans GO send écrit
