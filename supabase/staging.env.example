# YOUMBIA Lifecycle Email P0 — variables staging (AUCUNE valeur secrète ici)
# Copier vers un gestionnaire de secrets staging. Ne jamais committer de .env réel.
# Projet : Supabase STAGING indépendant — pas le ref production.

# --- Projet staging (à renseigner après création autorisée) ---
# SUPABASE_URL=https://<STAGING_PROJECT_REF>.supabase.co
# SUPABASE_ANON_KEY=<staging-anon>
# SUPABASE_SERVICE_ROLE_KEY=<staging-service-role>   # via SUPABASE_SECRET_KEYS.default côté Edge

# --- Edge Functions lifecycle (deploy staging only) ---
# LIFECYCLE_EMAIL_DISPATCH_SECRET=<random-32B>
# LIFECYCLE_EMAIL_HMAC_SECRET=<random-32B>
# LIFECYCLE_RESEND_WEBHOOK_SECRET=whsec_<staging-only>
# LIFECYCLE_RESEND_API_KEY=re_<staging-or-test-key>
# LIFECYCLE_FROM_EMAIL=YOUMBIA Staging <no-reply@mail.example.test>
# LIFECYCLE_PUBLIC_FUNCTIONS_BASE=https://<STAGING_PROJECT_REF>.supabase.co/functions/v1

# --- Safety (recette) ---
# LIFECYCLE_EMAIL_ALLOW_LIVE=false
# LIFECYCLE_EMAIL_DRY_RUN=true
# Kill switch DB : public.app_runtime_flags.lifecycle_email_kill_switch = 'true'

