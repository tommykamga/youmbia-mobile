{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "environment": "development",
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_ENV": "development",
        "EXPO_PUBLIC_APP_ENV": "development",
        "YOUMBIA_EAS_BUILD_PROFILE": "development",
        "YOUMBIA_EAS_PROJECT_ID": "SET_AFTER_QA_EAS_PROJECT_CREATION",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      }
    },
    "preview": {
      "environment": "preview",
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_ENV": "preview",
        "EXPO_PUBLIC_APP_ENV": "preview",
        "YOUMBIA_EAS_BUILD_PROFILE": "preview",
        "YOUMBIA_EAS_PROJECT_ID": "SET_AFTER_QA_EAS_PROJECT_CREATION"
      }
    },
    "production": {
      "environment": "production",
      "distribution": "store",
      "ios": {},
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "APP_ENV": "production",
        "EXPO_PUBLIC_APP_ENV": "production",
        "YOUMBIA_EAS_BUILD_PROFILE": "production"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "production",
        "releaseStatus": "completed"
      }
    }
  }
}
